<?xml version="1.0" encoding="UTF-8"?>
<xsd:schema xmlns:xsd="http://www.w3.org/2001/XMLSchema"
            targetNamespace="http://xmlns.jcp.org/xml/ns/javaee"
            xmlns:javaee="http://xmlns.jcp.org/xml/ns/javaee"
            elementFormDefault="qualified">

    <xsd:element name="web-app" type="javaee:web-appType"/>

    <xsd:complexType name="web-appType">
        <xsd:sequence>
            <xsd:element name="response-character-encoding" type="xsd:string" minOccurs="0"/>
            <xsd:element name="servlet" type="javaee:servletType" minOccurs="0" maxOccurs="unbounded"/>
            <xsd:element name="servlet-mapping" type="javaee:servlet-mappingType" minOccurs="0" maxOccurs="unbounded"/>
        </xsd:sequence>
        <xsd:attribute name="version" type="xsd:string" use="required"/>
    </xsd:complexType>

    <xsd:complexType name="servletType">
        <xsd:sequence>
            <xsd:element name="servlet-name" type="xsd:string"/>
            <xsd:element name="servlet-class" type="xsd:string"/>
            <xsd:element name="load-on-startup" type="xsd:int" minOccurs="0"/>
        </xsd:sequence>
    </xsd:complexType>

    <xsd:complexType name="servlet-mappingType">
        <xsd:sequence>
            <xsd:element name="servlet-name" type="xsd:string"/>
            <xsd:element name="url-pattern" type="xsd:string"/>
        </xsd:sequence>
    </xsd:complexType>

</xsd:schema>